{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MirrorSim",
  "version": "0.1.0",
  "identifier": "com.mahcks.mirrorsim",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MirrorSim",
        "width": 520,
        "height": 900,
        "minWidth": 430,
        "minHeight": 780,
        "center": true,
        "decorations": true,
        "maximizable": true,
        "transparent": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
